/* slidecast animation runtime + helper library.
 * Load AFTER GSAP (and optional plugins) and BEFORE the deck's inline choreography script.
 *
 * Two consumers share ONE seekable timeline `window.master`:
 *   - LIVE player: manual keyboard/click navigation with optional user-enabled timed advance.
 *   - VIDEO renderer (scripts/capture.js): keeps master paused and calls master.seek(t) per frame,
 *     mapping audio time -> master time via the labels added by sc.cue().
 *
 * Authoring flow (in the deck's inline script):
 *     sc.init({ autoMs: 6000 });
 *     sc.slide('slide-01');
 *       sc.cue('s1-title');   sc.entrance('#title', { y:40 });
 *       sc.cue('s1-barGrow'); sc.bars('.bar');
 *     sc.slide('slide-02'); ...
 *     sc.ready();
 *
 * Every sc.cue(name) adds a GSAP label at the current end of the master timeline, so the label time
 * equals the segment's start. The storyboard's cue.toLabel references these names. Helpers append to
 * the timeline end (no explicit position) so labels line up with segment starts.
 */
(function (global) {
  var hasGSAP = typeof gsap !== 'undefined';
  if (hasGSAP) gsap.ticker.lagSmoothing(0); // determinism: no CPU-dependent catch-up

  var master = hasGSAP ? gsap.timeline({ paused: true }) : null;
  // Ambient timeline: holds ENDLESS loops (sc.flow, looping emphasis) so they never make
  // master.duration() Infinity (which would break live nav + progress). In live mode it plays
  // continuously; in render mode the capturer seeks it to pause-aware global visual time.
  var ambient = hasGSAP ? gsap.timeline({ paused: true }) : null;
  var slideBounds = [];           // [{id, start}] master time where each slide begins
  var captions = [];              // [{t, d, w}] absolute word times (optional, set by deck or loader)
  var opts = { autoMs: 6000, subtitles: true };
  var reducedMotionQuery = global.matchMedia
    ? global.matchMedia('(prefers-reduced-motion: reduce)')
    : null;

  function prefersReducedMotion() {
    return !global.__slidecastRenderMode && !!(reducedMotionQuery && reducedMotionQuery.matches);
  }
  function motionScale() {
    var m = getComputedStyle(document.documentElement).getPropertyValue('--sc-motion').trim();
    var n = parseFloat(m); return isNaN(n) ? 1 : n;            // 0..3
  }
  // duration multiplier: motion 0 => fast/minimal, 3 => lively
  function dur(base) {
    var s = motionScale(); return base * (0.4 + s * 0.4);
  }
  function syncAmbientMotion() {
    if (!ambient || global.__slidecastRenderMode) return;
    if (prefersReducedMotion()) ambient.pause(0);
    else ambient.play();
  }
  var EASE = { soft: 'power2.out', back: 'back.out(1.4)', bounce: 'elastic.out(1,0.5)', none: 'none' };

  // keep progress bar + slide counter in sync — runs on every master update, so it works in BOTH
  // live playback AND video render (the renderer seeks master each frame -> onUpdate fires).
  function updateChrome() {
    if (!master) return;
    var prog = document.getElementById('sc-progress');
    if (prog && isFinite(master.duration()) && master.duration() > 0)
      prog.style.width = (master.progress() * 100) + '%';
    var cnt = document.getElementById('sc-counter');
    if (cnt && slideBounds.length) {
      var t = master.time(), idx = 0;
      for (var i = 0; i < slideBounds.length; i++) if (t >= slideBounds[i].start - 1e-4) idx = i;
      cnt.textContent = (idx + 1) + ' / ' + slideBounds.length;
    }
  }

  var sc = {
    master: master,
    ambient: ambient,

    init: function (o) {
      Object.assign(opts, o || {});
      // hide every slide initially; each sc.slide() reveals its own and hides the previous one,
      // recorded as zero-duration sets on the timeline so seeking shows the right slide at any t.
      if (hasGSAP) gsap.set('.slide', { autoAlpha: 0 });
      return sc;
    },

    /* mark the start of a slide (also adds a label `slide:<id>`) and handles slide show/hide */
    slide: function (id) {
      if (!master) return sc;
      master.addLabel('slide:' + id);
      var prev = slideBounds.length ? slideBounds[slideBounds.length - 1].id : null;
      master.set('.slide[data-slide="' + id + '"]', { autoAlpha: 1, zIndex: 2 });
      if (prev) master.set('.slide[data-slide="' + prev + '"]', { autoAlpha: 0, zIndex: 1 });
      slideBounds.push({ id: id, start: master.duration() });
      return sc;
    },

    /* add a named cue label at the current timeline end */
    cue: function (name) { if (master) master.addLabel(name); return sc; },

    /* ENTRANCE — staggered fade/slide/zoom. preset: 'rise'|'left'|'right'|'zoom'|'fade' */
    entrance: function (targets, o) {
      o = o || {}; if (!master) return sc;
      var from = { opacity: 0, ease: o.ease || EASE.soft, duration: dur(o.duration || 0.6),
                   stagger: o.stagger != null ? o.stagger : 0.1 };
      var p = o.preset || (o.y != null || o.x != null ? 'custom' : 'rise');
      if (p === 'rise') from.y = 30; else if (p === 'left') from.x = -40;
      else if (p === 'right') from.x = 40; else if (p === 'zoom') { from.scale = 0.85; }
      if (o.y != null) from.y = o.y; if (o.x != null) from.x = o.x;
      master.from(targets, from, o.at);
      return sc;
    },

    /* EMPHASIS — pulse/glow/shake a part. repeat:-1 (endless) is routed to the ambient timeline so
       it never makes master.duration() infinite; finite repeats stay on the master choreography. */
    emphasis: function (target, o) {
      o = o || {}; if (!master) return sc;
      var rep = o.repeat != null ? o.repeat : 3, t = o.type || 'pulse';
      var tl = (rep === -1) ? ambient : master;
      var at = (rep === -1) ? (o.at || 0) : o.at;
      if (t === 'pulse')
        tl.to(target, { scale: 1.15, transformOrigin: 'center', yoyo: true, repeat: rep,
                        duration: dur(0.4), ease: 'sine.inOut' }, at);
      else if (t === 'glow')
        tl.to(target, { filter: 'drop-shadow(0 0 12px currentColor)', yoyo: true, repeat: rep,
                        duration: dur(0.5) }, at);
      else if (t === 'shake')
        tl.to(target, { x: '+=8', yoyo: true, repeat: rep < 0 ? -1 : rep * 2, duration: dur(0.06) }, at);
      return sc;
    },

    /* DRAW-ON SVG stroke (uses DrawSVGPlugin if present, else stroke-dashoffset) */
    draw: function (selector, o) {
      o = o || {}; if (!master) return sc;
      var els = document.querySelectorAll(selector);
      if (typeof DrawSVGPlugin !== 'undefined') {
        master.from(selector, { drawSVG: '0%', duration: dur(o.duration || 1.4), ease: EASE.none,
                               stagger: o.stagger || 0 }, o.at);
      } else {
        els.forEach(function (p) {
          var len = p.getTotalLength ? p.getTotalLength() : 100;
          p.style.strokeDasharray = len; p.style.strokeDashoffset = len;
          master.to(p, { strokeDashoffset: 0, duration: dur(o.duration || 1.4), ease: EASE.none }, o.at);
        });
      }
      return sc;
    },

    /* REVEAL — wipe in via scale (axis 'x' or 'y'); good for rules/underlines/bars */
    reveal: function (target, o) {
      o = o || {}; if (!master) return sc;
      var axis = o.axis === 'y' ? 'scaleY' : 'scaleX';
      var from = {}; from[axis] = 0;
      from.transformOrigin = o.axis === 'y' ? 'bottom' : 'left';
      from.duration = dur(o.duration || 0.6); from.ease = o.ease || EASE.soft;
      master.from(target, from, o.at);
      return sc;
    },

    /* FLOW — endless "marching ants" along a dashed path. Lives on the AMBIENT timeline so it never
       makes master.duration() infinite. In render mode the capturer seeks ambient to video time. */
    flow: function (selector, o) {
      o = o || {}; if (!ambient) return sc;
      ambient.to(selector, { strokeDashoffset: '-=' + (o.gap || 20), repeat: -1,
                            duration: dur(o.duration || 0.6), ease: EASE.none }, o.at || 0);
      return sc;
    },

    /* MOVE a token along a path (needs MotionPathPlugin) */
    move: function (target, pathSel, o) {
      o = o || {}; if (!master || typeof MotionPathPlugin === 'undefined') return sc;
      var rep = o.repeat != null ? o.repeat : 0;
      var tl = rep === -1 ? ambient : master;
      var at = rep === -1 ? (o.at || 0) : o.at;
      tl.to(target, { motionPath: { path: pathSel, align: pathSel, autoRotate: !!o.autoRotate },
                      duration: dur(o.duration || 3), ease: o.ease || EASE.none,
                      repeat: rep }, at);
      return sc;
    },

    /* COUNT-UP a number into a DOM node */
    countUp: function (target, to, o) {
      o = o || {}; if (!master) return sc;
      var el = typeof target === 'string' ? document.querySelector(target) : target;
      var proxy = { v: o.from || 0 }, fmt = o.format || function (v) { return Math.round(v).toLocaleString(); };
      master.to(proxy, { v: to, duration: dur(o.duration || 1.8), ease: 'power1.out',
                        onUpdate: function () { if (el) el.textContent = fmt(proxy.v); } }, o.at);
      return sc;
    },

    /* CHART bars grow from baseline (transform-origin:bottom) */
    bars: function (selector, o) {
      o = o || {}; if (!master) return sc;
      master.from(selector, { scaleY: 0, transformOrigin: 'bottom', duration: dur(o.duration || 0.8),
                             stagger: o.stagger != null ? o.stagger : 0.1, ease: 'power3.out' }, o.at);
      return sc;
    },

    /* TYPEWRITER (needs SplitText; else fades whole element) */
    type: function (selector, o) {
      o = o || {}; if (!master) return sc;
      if (typeof SplitText !== 'undefined') {
        var split = new SplitText(selector, { type: 'chars' });
        master.from(split.chars, { opacity: 0, duration: 0.02, stagger: o.speed || 0.04 }, o.at);
      } else master.from(selector, { opacity: 0, duration: dur(0.6) }, o.at);
      return sc;
    },

    /* REVEAL a video/element into a shape via clip-path animation */
    revealShape: function (selector, o) {
      o = o || {}; if (!master) return sc;
      var to = o.shape === 'circle' ? 'circle(75% at 50% 50%)' : 'inset(0% round var(--sc-radius))';
      var from = o.shape === 'circle' ? 'circle(0% at 50% 50%)' : 'inset(50% round var(--sc-radius))';
      master.fromTo(selector, { clipPath: from }, { clipPath: to, duration: dur(o.duration || 1) }, o.at);
      return sc;
    },

    setCaptions: function (arr) { captions = arr || []; return sc; },

    /* finalize: expose duration + labels; wire chrome; start LIVE player unless we are being rendered */
    ready: function () {
      global.__slidecastReady = true;
      if (master) { master.eventCallback('onUpdate', updateChrome); updateChrome(); }
      if (!global.__slidecastRenderMode && master) {
        Player.start();
        syncAmbientMotion();
        if (reducedMotionQuery) {
          var onMotionPreferenceChange = function () {
            if (Player._tw) { Player._tw.kill(); Player._tw = null; }
            if (prefersReducedMotion() && Player.idx >= 0) {
              master.pause();
              master.seek(Player.endOf(Player.idx));
              updateChrome();
            }
            if (Player.auto) Player.scheduleAuto();
            syncAmbientMotion();
          };
          if (reducedMotionQuery.addEventListener)
            reducedMotionQuery.addEventListener('change', onMotionPreferenceChange);
          else if (reducedMotionQuery.addListener)
            reducedMotionQuery.addListener(onMotionPreferenceChange);
        }
      }
      document.dispatchEvent(new CustomEvent('slidecast:ready'));
      return sc;
    }
  };

  /* ---------- LIVE player — PAGE-BY-PAGE (PowerPoint-style). Ignored during video render. ----------
     Each slide plays its entrance once, then HOLDS on the fully-revealed slide until the user advances.
     Space/Enter/→/↓/PageDown = next · ←/↑/PageUp = previous · Home/End = first/last ·
     a = toggle per-page autoplay · f = fullscreen · c = captions (reads each slide's data-caption). */
  var Player = {
    idx: -1, auto: false, timer: null, _tw: null,
    start: function () {
      if (!master) return;
      this.bindNav();
      this.show(0, false);                 // reveal the first slide, then hold
    },
    // time to pause at: just before the next slide's reveal fires (so this slide stays fully revealed)
    endOf: function (i) {
      return (i + 1 < slideBounds.length) ? slideBounds[i + 1].start - 0.001 : master.duration();
    },
    show: function (i, immediate) {
      if (!slideBounds.length) return;
      i = Math.max(0, Math.min(i, slideBounds.length - 1));
      this.idx = i;
      this.showCaption(i);
      clearTimeout(this.timer);
      if (this._tw) { this._tw.kill(); this._tw = null; }
      var to = this.endOf(i), self = this;
      if (immediate || prefersReducedMotion()) { // reduced motion shows the completed static state
        master.pause(); master.seek(to); updateChrome();
        if (self.auto) self.scheduleAuto();
      } else {                             // play this slide's fly-in, then stop on its end state
        this._tw = master.tweenFromTo(slideBounds[i].start, to, {
          ease: 'none', onUpdate: updateChrome,
          onComplete: function () { self._tw = null; if (self.auto) self.scheduleAuto(); }
        });
      }
    },
    next: function () {
      if (this.idx < slideBounds.length - 1) this.show(this.idx + 1, false);
      else if (this.auto) this.show(0, false);          // loop only while autoplaying
    },
    prev: function () { this.show(this.idx - 1, true); },
    // live captions: show the current slide's narration text in #sc-subtitle (toggle with 'c')
    showCaption: function (i) {
      var box = document.getElementById('sc-subtitle');
      if (!box || !slideBounds[i]) return;
      var el = document.querySelector('.slide[data-slide="' + slideBounds[i].id + '"]');
      box.textContent = (el && el.getAttribute('data-caption')) || '';
    },
    scheduleAuto: function () {
      var self = this; clearTimeout(this.timer);
      this.timer = setTimeout(function () { self.next(); }, opts.autoMs || 6000);
    },
    toggleAuto: function () {
      this.auto = !this.auto;
      if (this.auto) { if (!this._tw) this.scheduleAuto(); } else clearTimeout(this.timer);
    },
    stopAuto: function () { this.auto = false; clearTimeout(this.timer); },
    bindNav: function () {
      var self = this;
      document.addEventListener('keydown', function (e) {
        if (['ArrowRight', 'ArrowDown', ' ', 'Enter', 'PageDown'].includes(e.key)) {
          e.preventDefault(); self.stopAuto(); self.next();
        } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
          e.preventDefault(); self.stopAuto(); self.prev();
        } else if (e.key === 'Home') { e.preventDefault(); self.stopAuto(); self.show(0, true); }
        else if (e.key === 'End') { e.preventDefault(); self.stopAuto(); self.show(slideBounds.length - 1, true); }
        else if (e.key === 'a' || e.key === 'A') { self.toggleAuto(); }
        else if (e.key === 'f') { document.documentElement.requestFullscreen?.(); }
        else if (e.key === 'c') {
          var cb = document.getElementById('cc-check');
          if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
          else document.body.classList.toggle('subtitles-off');
        }
      });
      document.addEventListener('click', function (e) {
        if (e.target.closest('a,button,input,label,.cc-toggle,.sc-interactive')) return;
        self.stopAuto();
        e.clientX > innerWidth / 2 ? self.next() : self.prev();
      });
    }
  };

  global.sc = sc;
  global.master = master;            // the seekable choreography timeline the renderer drives
  global.ambient = ambient;          // endless loops; renderer seeks to pause-aware visual time
  global.__slidecastPlayer = Player;
})(window);
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trustworthy GMP/MPFR Evidence on Windows Arm64</title>
<link rel="stylesheet" href="styles/presets.css">
<script src="vendor/gsap.min.js"></script>
<script src="vendor/MotionPathPlugin.min.js"></script>
<script src="vendor/SplitText.min.js"></script>
<script>if(window.gsap&&window.MotionPathPlugin)gsap.registerPlugin(MotionPathPlugin);</script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#161821;color:var(--sc-fg);font-family:"Segoe UI",Arial,sans-serif}
.bg{position:fixed;inset:0;background:
radial-gradient(circle at 82% 12%,rgba(189,147,249,.18),transparent 32%),
radial-gradient(circle at 8% 92%,rgba(80,250,123,.10),transparent 28%),
linear-gradient(145deg,#20222d,#151720 70%);z-index:-2}
.grid{position:fixed;inset:0;opacity:.12;z-index:-1;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:72px 72px}
#sc-stage{position:relative;width:100vw;height:100vh}
.slide{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:11vh 8vw 16vh;gap:26px}
.topbar{position:fixed;top:0;left:0;right:0;z-index:1000;padding:3.2vh 8vw;display:flex;align-items:center;justify-content:space-between;font-size:15px;color:#aab0c3}
.brand{display:flex;align-items:center;gap:12px;color:#fff;font-weight:700}.mark{width:34px;height:34px;border-radius:8px;background:#bd93f9;color:#20222d;display:grid;place-items:center;font-weight:900}
.status{border:1px solid #ffb86c;color:#ffcf99;background:rgba(255,184,108,.10);padding:7px 12px;border-radius:999px;font-weight:800;letter-spacing:.08em}
#sc-progress{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,#bd93f9,#50fa7b);z-index:1100}
#sc-subtitle{position:fixed;left:50%;bottom:6vh;transform:translateX(-50%);z-index:1100;max-width:78vw;text-align:center;font-size:22px;line-height:1.35;background:rgba(5,6,10,.86);padding:.55em 1em;border-radius:10px}
#sc-subtitle:empty,body.subtitles-off #sc-subtitle{display:none}
.eyebrow{font-size:17px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#bd93f9}
h1{font-size:clamp(62px,7vw,118px);line-height:.94;letter-spacing:-.045em;max-width:15ch}
h2{font-size:clamp(42px,4.8vw,78px);line-height:1.02;letter-spacing:-.035em;max-width:18ch}
.lead{font-size:clamp(22px,2vw,31px);line-height:1.45;color:#c3c8d8;max-width:52ch}
.accent{color:#50fa7b}.warn{color:#ffb86c}.purple{color:#bd93f9}
.rule{height:5px;width:130px;border-radius:4px;background:linear-gradient(90deg,#bd93f9,#50fa7b)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.cards.two{grid-template-columns:repeat(2,1fr)}
.card{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:27px;min-height:180px;box-shadow:0 20px 55px rgba(0,0,0,.22)}
.card h3{font-size:24px;margin-bottom:12px}.card p{font-size:19px;line-height:1.45;color:#aeb4c8}.card strong{color:#fff}
.metric-row{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.metric{border-top:3px solid #bd93f9;padding-top:18px}
.metric .n{font-size:66px;font-weight:900;letter-spacing:-.04em}.metric .l{font-size:18px;color:#aeb4c8;margin-top:8px}
.code{font-family:Consolas,"Courier New",monospace;background:#0d0f15;border:1px solid #35394a;border-radius:12px;padding:24px;font-size:21px;line-height:1.55;color:#f8f8f2}
.bad{color:#ff5555;text-decoration:line-through}.good{color:#50fa7b}.dim{color:#6272a4}
.pipeline{display:flex;align-items:center;gap:14px}.node{padding:18px 22px;border:1px solid #555b72;border-radius:10px;background:#252834;font-size:20px;font-weight:700}.arrow{color:#50fa7b;font-size:30px}
.gate{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.gate-card{padding:28px;border-radius:14px;border:1px solid #454b60;background:#222530}.gate-card.done{border-color:#50fa7b}.gate-card.partial{border-color:#8be9fd}.gate-card.pending{border-color:#ffb86c;background:rgba(255,184,108,.08)}.gate-card .tag{font-weight:900;letter-spacing:.1em;margin-bottom:18px}.gate-card h3{font-size:29px;margin-bottom:12px}.gate-card p{font-size:18px;color:#b9bfd0;line-height:1.4}
.hash{font-family:Consolas,monospace;font-size:15px;word-break:break-all;color:#aeb4c8;margin-top:10px}
.source{position:absolute;top:8.5vh;right:8vw;font-size:13px;color:#7f869d}
.center{align-items:center;text-align:center}.center h1,.center h2,.center .lead{max-width:22ch}
@media(max-width:900px){.cards,.cards.two,.metric-row,.gate{grid-template-columns:1fr}.slide{padding:10vh 6vw 14vh}.card{min-height:auto}.topbar{padding:2vh 6vw}}
</style>
</head>
<body class="theme-devDark">
<div class="bg"></div><div class="grid"></div>
<header class="topbar"><div class="brand"><span class="mark">G</span><span>GMP / MPFR · Windows Arm64 Hackathon</span></div><div><span class="status">X64 CERTIFICATION: UNRESOLVED · ARM64 NATIVE: PENDING</span>&nbsp;&nbsp;<span id="sc-counter">1 / 13</span></div></header>
<div id="sc-progress"></div><div id="sc-subtitle"></div>
<main id="sc-stage">
<section class="slide" data-slide="s1" data-caption="GMP and MPFR provide arbitrary-precision arithmetic used across CAD, geometry, security, and scientific software.">
  <span class="source">Evidence: E1 §§1–3</span><div class="eyebrow" id="s1-ey">Trustworthy build evidence</div>
  <h1 id="s1-title">Precision needs <span class="accent">proof.</span></h1><div class="rule" id="s1-rule"></div>
  <p class="lead" id="s1-lead">On Windows Arm, the question is not only whether code builds—but what source, architecture, and tests the artifact can prove.</p>
</section>
<section class="slide" data-slide="s2" data-caption="The community recipe already contained Arm64 build paths, and vcpkg Arm64 support had already landed.">
  <span class="source">Evidence: E1 §§2.1–2.2; E5</span><div class="eyebrow">Finding 01 · premise check</div>
  <h2 id="s2-title">Arm64 paths already existed.</h2>
  <div class="cards two" id="s2-cards"><div class="card"><h3>Community recipe</h3><p>Existing Windows <strong>Arm64 build paths</strong></p></div><div class="card"><h3>vcpkg</h3><p>Arm64 support previously landed in <strong>PR #27787</strong></p></div></div>
  <p class="lead warn" id="s2-note">Claiming first-time Arm64 support would be wrong.</p>
</section>
<section class="slide" data-slide="s3" data-caption="The real gap was trust: input identity, fail-fast behavior, architecture, and structured evidence.">
  <span class="source">Evidence: E1 §§2.1, 5.2</span><div class="eyebrow">The real gap</div><h2 id="s3-title">Build scripts could not close the trust loop.</h2>
  <div class="code" id="s3-code"><span class="bad">FULL64_BIT</span> <span class="dim"># misspelled contract</span><br>command_1<br>command_2 <span class="dim"># could hide earlier failure</span><br><span class="warn">source identity: unlocked</span><br><span class="warn">artifact ↔ test record: unbound</span></div>
</section>
<section class="slide" data-slide="s4" data-caption="The fork review loop converged on HEAD 9fad07a3 after thirteen Copilot review submissions, zero new comments, and zero open threads.">
  <span class="source">Evidence: current fork review state; upstream draft PR #1</span><div class="eyebrow">Review loop converged</div><h2 id="s4-title">13 reviews. 0 new comments. 0 open threads.</h2>
  <div class="code" id="s4-code"><span class="dim">HEAD</span> <span class="good">9fad07a3e5255e805374863ec91498499608b5b3</span><br><span class="dim">upstream</span> developer-corner/win64-gmp-mpfr/pull/1<br><span class="warn">status: DRAFT</span></div>
  <p class="lead warn" id="s4-note">Converged review is not certification or upstream acceptance.</p>
</section>
<section class="slide" data-slide="s5" data-caption="Manifest and fail-fast self-tests pass, validating the machinery but not the GMP or MPFR test suites.">
  <span class="source">Evidence: current self-test results</span><div class="eyebrow">Self-tests</div><h2 id="s5-title">The evidence machinery passes.</h2>
  <div class="cards two" id="s5-cards"><div class="card"><h3 class="accent">Manifest self-test · PASS</h3><p>Manifest rules execute as designed.</p></div><div class="card"><h3 class="accent">Fail-fast self-test · PASS</h3><p>Controlled errors are rejected.</p></div></div>
  <p class="lead warn" id="s5-note">Scope boundary: these are not GMP/MPFR suite results.</p>
</section>
<section class="slide" data-slide="s6" data-caption="Native x64 source builds reach both suites, but the existing Windows runner returns exit zero despite reported failures.">
  <span class="source">Evidence: current native x64 runner and summaries</span><div class="eyebrow">False-success signal</div><h2 id="s6-title">Exit 0 does not mean the tests passed.</h2>
  <div class="pipeline" id="s6-flow"><div class="node">Source build</div><div class="arrow">→</div><div class="node">GMP + MPFR suites</div><div class="arrow">→</div><div class="node warn">Failures in summaries</div><div class="arrow">≠</div><div class="node accent">Runner exit 0</div></div>
  <p class="lead warn" id="s6-note">Certification cannot rely on the runner exit code alone.</p>
</section>
<section class="slide" data-slide="s7" data-caption="GMP reports 200 overall, 138 succeeded, 61 failed, and one skipped.">
  <span class="source">Evidence: parsed current GMP summary</span><div class="eyebrow">x64 diagnosis · GMP</div><h2 id="s7-title">61 failures keep the GMP gate open.</h2>
  <div class="metric-row" id="s7-metrics"><div class="metric"><div class="n">200</div><div class="l">overall</div></div><div class="metric"><div class="n accent">138</div><div class="l">succeeded</div></div><div class="metric"><div class="n warn">61 · 1</div><div class="l">failed · skipped</div></div></div>
</section>
<section class="slide" data-slide="s8" data-caption="MPFR reports 197 overall, 172 succeeded, 18 failed, and seven skipped.">
  <span class="source">Evidence: parsed current MPFR summary</span><div class="eyebrow">x64 diagnosis · MPFR</div><h2 id="s8-title">18 failures keep the MPFR gate open.</h2>
  <div class="metric-row" id="s8-metrics"><div class="metric"><div class="n">197</div><div class="l">overall</div></div><div class="metric"><div class="n accent">172</div><div class="l">succeeded</div></div><div class="metric"><div class="n warn">18 · 7</div><div class="l">failed · skipped</div></div></div>
</section>
<section class="slide" data-slide="s9" data-caption="The validator strips ANSI, parses summaries, rejects failures, exits nonzero, and emits no certifying manifest.">
  <span class="source">Evidence: current validator result</span><div class="eyebrow">Verified project result</div><h2 id="s9-title">The validator fails closed.</h2>
  <div class="pipeline" id="s9-flow"><div class="node">Strip ANSI</div><div class="arrow">→</div><div class="node">Parse summaries</div><div class="arrow">→</div><div class="node warn">Reject failures</div><div class="arrow">→</div><div class="node warn">Nonzero exit</div></div>
  <div class="code" id="s9-code"><span class="bad">certifying manifest</span> <span class="warn">NOT EMITTED</span></div>
</section>
<section class="slide" data-slide="s10" data-caption="The x64 gate is unresolved; old sizes, hashes, native-tests-passed labels, and certified consumer claims are superseded.">
  <span class="source">Evidence: current summary and validator outcome</span><div class="eyebrow">Superseded x64 story</div><h2 id="s10-title">Diagnosis replaces false certification.</h2>
  <div class="cards two" id="s10-cards"><div class="card"><h3 class="bad">Tests passed</h3><p>Not supported by full summaries.</p></div><div class="card"><h3 class="bad">Certified artifacts</h3><p>No final hashes, sizes, native-tests-passed status, or certified consumer proof.</p></div></div>
  <p class="lead warn" id="s10-note">X64 CERTIFICATION: UNRESOLVED</p>
</section>
<section class="slide" data-slide="s11" data-caption="The upstream contribution is draft pull request one; draft status is not acceptance, merge, signing, release, or publication.">
  <span class="source">Evidence: github.com/developer-corner/win64-gmp-mpfr/pull/1</span><div class="eyebrow">Upstream review surface</div><h2 id="s11-title">Draft PR #1 is open for review.</h2>
  <div class="code" id="s11-code">https://github.com/developer-corner/win64-gmp-mpfr/pull/1<br><br><span class="warn">DRAFT · not accepted · not merged · not published</span></div>
</section>
<section class="slide" data-slide="s12" data-caption="No performance, power, signing, publication, certification, or downstream-unblocking claim is supported.">
  <span class="source">Evidence: current claim boundary</span><div class="eyebrow">What this result does not claim</div><h2 id="s12-title">Detection—not success theater.</h2>
  <div class="cards" id="s12-cards"><div class="card"><h3>Performance / power</h3><p>Not measured.</p></div><div class="card"><h3>Signing / publication</h3><p>Not completed.</p></div><div class="card"><h3>Certification / downstream unblock</h3><p>Not established.</p></div></div>
  <p class="lead accent" id="s12-note">A misleading zero exit can no longer create a certifying manifest.</p>
</section>
<section class="slide" data-slide="s13" data-caption="Two gates remain: clean x64 summaries through the validator, and build and tests on a native Windows Arm64 machine.">
  <span class="source">Evidence: current validator outcome and native Arm64 requirement</span><div class="eyebrow">Two unresolved gates</div><h2 id="s13-title">Both must close before success.</h2>
  <div class="cards two" id="s13-gates"><div class="gate-card pending"><div class="tag warn">UNRESOLVED</div><h3>x64 test diagnosis</h3><p>Fix failures and obtain clean parsed summaries through the validator.</p></div><div class="gate-card pending"><div class="tag warn">PENDING</div><h3>Native Windows Arm64</h3><p>Run the locked build, GMP/MPFR suites, and required consumer evidence on native hardware.</p></div></div>
  <p class="lead warn" id="s13-note">No certifying manifest until the evidence passes.</p>
</section>
</main>
<script src="animations/anim.js"></script>
<script>
window.__slidecastRenderMode=new URLSearchParams(location.search).has('render');
sc.init({autoMs:14000,subtitles:true});
sc.slide('s1');sc.cue('s1-proof');sc.entrance('#s1-ey',{preset:'rise'});sc.entrance('#s1-title',{preset:'rise',duration:.9,at:'<+.08'});sc.reveal('#s1-rule',{axis:'x',at:'<+.12'});sc.entrance('#s1-lead',{preset:'fade'});
sc.slide('s2');sc.cue('s2-existing');sc.entrance('#s2-title',{preset:'left'});sc.entrance('#s2-cards .card',{preset:'rise',stagger:.16});sc.entrance('#s2-note',{preset:'fade'});
sc.slide('s3');sc.cue('s3-trust');sc.entrance('#s3-title',{preset:'left'});sc.entrance('#s3-code',{preset:'rise'});sc.emphasis('.bad',{type:'glow',repeat:2});
sc.slide('s4');sc.cue('s4-review');sc.entrance('#s4-title',{preset:'left'});sc.entrance('#s4-code',{preset:'rise'});sc.entrance('#s4-note',{preset:'fade'});
sc.slide('s5');sc.cue('s5-selftests');sc.entrance('#s5-title',{preset:'left'});sc.entrance('#s5-cards .card',{preset:'rise',stagger:.14});sc.entrance('#s5-note',{preset:'fade'});
sc.slide('s6');sc.cue('s6-runner');sc.entrance('#s6-title',{preset:'left'});sc.entrance('#s6-flow > *',{preset:'rise',stagger:.09});sc.entrance('#s6-note',{preset:'fade'});
sc.slide('s7');sc.cue('s7-gmp');sc.entrance('#s7-title',{preset:'left'});sc.entrance('#s7-metrics .metric',{preset:'rise',stagger:.15});
sc.slide('s8');sc.cue('s8-mpfr');sc.entrance('#s8-title',{preset:'left'});sc.entrance('#s8-metrics .metric',{preset:'rise',stagger:.15});
sc.slide('s9');sc.cue('s9-validator');sc.entrance('#s9-title',{preset:'left'});sc.entrance('#s9-flow > *',{preset:'rise',stagger:.09});sc.entrance('#s9-code',{preset:'fade'});
sc.slide('s10');sc.cue('s10-unresolved');sc.entrance('#s10-title',{preset:'left'});sc.entrance('#s10-cards .card',{preset:'rise',stagger:.15});sc.entrance('#s10-note',{preset:'fade'});
sc.slide('s11');sc.cue('s11-pr');sc.entrance('#s11-title',{preset:'left'});sc.entrance('#s11-code',{preset:'rise'});
sc.slide('s12');sc.cue('s12-boundary');sc.entrance('#s12-title',{preset:'left'});sc.entrance('#s12-cards .card',{preset:'rise',stagger:.15});sc.entrance('#s12-note',{preset:'fade'});
sc.slide('s13');sc.cue('s13-gates');sc.entrance('#s13-title',{preset:'left'});sc.entrance('#s13-gates .gate-card',{preset:'rise',stagger:.16});sc.entrance('#s13-note',{preset:'fade'});
sc.ready();
</script>
</body>
</html>
/* slidecast — style presets.
   Each preset is a body class `.theme-<name>` that sets --sc-* design tokens consumed by deck.html
   and the partials. Swap the look of an entire deck by changing one body class.
   Tokens: --sc-bg, --sc-fg, --sc-muted, --sc-accent, --sc-accent2, --sc-surface, --sc-border,
   --sc-radius, --sc-font-head, --sc-font-body, --sc-font-code, --sc-motion (0..3), --sc-density (1..5).
   See references/style-gallery.md for when to auto-suggest each. */

:root {
  /* sensible fallbacks (≈ minimalKeynote) */
  --sc-bg:#ffffff; --sc-fg:#1d1d1f; --sc-muted:#6e6e73;
  --sc-accent:#0071e3; --sc-accent2:#00a3a1;
  --sc-surface:rgba(0,0,0,.04); --sc-border:rgba(0,0,0,.12);
  --sc-radius:14px;
  --sc-font-head:"Inter","SF Pro Display",-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;
  --sc-font-body:"Inter",-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;
  --sc-font-code:"JetBrains Mono","Fira Code",Consolas,"Courier New",monospace;
  --sc-motion:1; --sc-density:2;
  --sc-bg-image:none;
  /* shared design tokens (themes override where needed) */
  --sc-accent-fg:#ffffff;
  --sc-accent-soft:color-mix(in srgb, var(--sc-accent) 12%, transparent);
  --sc-success:#16a34a; --sc-danger:#dc2626;
  --sc-shadow:0 1px 2px rgba(16,24,40,.06), 0 8px 24px rgba(16,24,40,.06);
  --sc-shadow-lg:0 24px 60px rgba(16,24,40,.18);
  --sc-orb-opacity:.16;
}
/* dark decks get deeper, softer shadows and a fainter orb */
.theme-pitchDeck, .theme-devDark, .theme-saasGradient {
  --sc-shadow:0 1px 2px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.36);
  --sc-shadow-lg:0 30px 70px rgba(0,0,0,.5);
  --sc-orb-opacity:.22;
}

/* 1. Minimal / Apple Keynote */
.theme-minimalKeynote{
  --sc-bg:#ffffff; --sc-fg:#1d1d1f; --sc-muted:#6e6e73; --sc-accent:#0071e3; --sc-accent2:#34c759;
  --sc-surface:rgba(0,0,0,.04); --sc-border:rgba(0,0,0,.10); --sc-radius:0;
  --sc-font-head:"Inter","SF Pro Display",-apple-system,sans-serif; --sc-font-body:"Inter",sans-serif;
  --sc-motion:1; --sc-density:1;
}
.theme-minimalKeynote.dark{ --sc-bg:#000; --sc-fg:#f5f5f7; --sc-muted:#86868b; --sc-surface:rgba(255,255,255,.06); --sc-border:rgba(255,255,255,.12); }

/* 2. Consulting Report (McKinsey/BCG) */
.theme-consultingReport{
  --sc-bg:#ffffff; --sc-fg:#0a2540; --sc-muted:#667085; --sc-accent:#00a3a1; --sc-accent2:#0a2540;
  --sc-surface:#f7f9fb; --sc-border:#d0d5dd; --sc-radius:2px;
  --sc-font-head:Georgia,"Times New Roman",serif; --sc-font-body:Arial,"Helvetica Neue",sans-serif;
  --sc-motion:0; --sc-density:5;
}

/* 3. Startup Pitch (Sequoia/YC) */
.theme-pitchDeck{
  --sc-bg:#0e1116; --sc-fg:#ffffff; --sc-muted:#9aa4b2; --sc-accent:#635bff; --sc-accent2:#16c79a;
  --sc-surface:rgba(255,255,255,.06); --sc-border:rgba(255,255,255,.14); --sc-radius:12px;
  --sc-font-head:"Inter",sans-serif; --sc-font-body:"Inter",system-ui,sans-serif;
  --sc-motion:2; --sc-density:2;
}

/* 4. Developer Dark (Dracula) */
.theme-devDark{
  --sc-bg:#282a36; --sc-fg:#f8f8f2; --sc-muted:#6272a4; --sc-accent:#bd93f9; --sc-accent2:#50fa7b;
  --sc-surface:rgba(255,255,255,.04); --sc-border:rgba(255,255,255,.10); --sc-radius:8px;
  --sc-font-head:"Inter",-apple-system,sans-serif; --sc-font-body:"Inter",sans-serif;
  --sc-font-code:"Fira Code","JetBrains Mono",Consolas,monospace;
  --sc-motion:1; --sc-density:3;
}

/* 5. Editorial / Magazine */
.theme-editorial{
  --sc-bg:#faf8f4; --sc-fg:#1a1a1a; --sc-muted:#6b6b6b; --sc-accent:#b8462f; --sc-accent2:#1a1a1a;
  --sc-surface:#f2ede3; --sc-border:#e0d8c8; --sc-radius:0;
  --sc-font-head:"Playfair Display",Georgia,serif; --sc-font-body:"Inter",sans-serif;
  --sc-motion:2; --sc-density:2;
}

/* 6. SaaS Gradient / Glass */
.theme-saasGradient{
  --sc-bg:#1a1340; --sc-bg-image:linear-gradient(135deg,#6d5efc 0%,#b06ab3 50%,#ff8b8b 100%);
  --sc-fg:#ffffff; --sc-muted:rgba(255,255,255,.78); --sc-accent:#00d4ff; --sc-accent2:#635bff;
  --sc-surface:rgba(255,255,255,.12); --sc-border:rgba(255,255,255,.22); --sc-radius:20px;
  --sc-font-head:"Inter",sans-serif; --sc-font-body:"Inter",sans-serif;
  --sc-motion:3; --sc-density:2;
}
.theme-saasGradient .card{ backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); }

/* 7. Playful / Education */
.theme-playfulEdu{
  --sc-bg:#fff7ed; --sc-fg:#2b2d42; --sc-muted:#5b5d72; --sc-accent:#ef476f; --sc-accent2:#06d6a0;
  --sc-accent3:#ffd166; --sc-surface:#ffffff; --sc-border:#ffe0c2; --sc-radius:24px;
  --sc-font-head:"Poppins","Baloo 2",sans-serif; --sc-font-body:"Nunito","Poppins",sans-serif;
  --sc-motion:3; --sc-density:2;
}

/* 8. Data-Journalism Editorial (paged variant) */
.theme-editorialData{
  --sc-bg:#ffffff; --sc-fg:#121212; --sc-muted:#666666; --sc-accent:#e2562b; --sc-accent2:#121212;
  --sc-surface:#f6f6f6; --sc-border:#e6e6e6; --sc-radius:4px;
  --sc-font-head:Georgia,"Tiempos",serif; --sc-font-body:"Inter",sans-serif;
  --sc-motion:2; --sc-density:4;
}
